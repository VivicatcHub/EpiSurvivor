# Base PostgreSQL servie par geo-emploi-db (compose.yaml expose 5555).
DATABASE_URL=postgresql+psycopg2://admin:admin@localhost:5555/geo_emploi

JWT_SECRETKEY=ChangeMe123!
JWT_ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=60

# true derrière HTTPS uniquement.
COOKIE_SECURE=false

# Origines navigateur autorisées (le front serveur-à-serveur n'en a pas besoin).
CORS_ORIGINS=http://localhost:3000
