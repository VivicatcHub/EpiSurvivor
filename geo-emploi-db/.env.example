# Copier en .env : docker compose et alembic lisent tous les deux ce fichier.
POSTGRES_USER=geo_emploi
POSTGRES_PASSWORD=geo_emploi
POSTGRES_DB=geo_emploi
POSTGRES_PORT=5432

# Utilisée par alembic/env.py. Depuis l'hôte, host = localhost ;
# depuis un conteneur du même réseau compose, host = db.
DATABASE_URL=postgresql+psycopg2://geo_emploi:geo_emploi@localhost:5432/geo_emploi
